ANTHROPIC_API_KEY=cole_sua_chave_apenas_no_arquivo_local
CLAUDE_MODEL=claude-sonnet-5
SOFIA_MODULES=infraestrutura,medicina,almoxarifado
# Base cross-platform; use an absolute path only in .env.local when desired.
SOFIA_KNOWLEDGE_BASE_PATH=./
KNOWLEDGE_DIR=knowledge
SOFIA_SETUP_TOKEN=defina_um_token_local_apenas_para_o_primeiro_cadastro
SOFIA_COOKIE_SECURE=0
SOFIA_TOTP_ENABLED=0
SOFIA_PORT=8000
SOFIA_HOST=127.0.0.1
SOFIA_ALLOWED_ORIGINS=http://127.0.0.1:8443,http://localhost:8443,http://127.0.0.1:8444,http://localhost:8444
SOFIA_ACTIVATION_TOKEN_MINUTES=60
# Recuperação administrativa emergencial: desabilitada e apenas em loopback.
SOFIA_BREAK_GLASS_RECOVERY_ENABLED=0
SOFIA_BREAK_GLASS_RECOVERY_TOKEN=use_um_token_distinto_do_setup
SOFIA_BREAK_GLASS_ALLOW_GLOBAL=0
SOFIA_MAX_UPLOAD_BYTES=104857600
SOFIA_DB_INLINE_CONTENT_MAX_BYTES=5242880
SOFIA_MAX_CRAWL_PAGES=20
SOFIA_MAX_CRAWL_TOTAL_BYTES=26214400
SOFIA_MAX_CRAWL_DEPTH=2
SOFIA_MAX_LINKED_DOCUMENTS=20
SOFIA_RESPECT_ROBOTS=1
SOFIA_EMBEDDINGS_ENABLED=0
SOFIA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SOFIA_VECTOR_SEARCH_ENABLED=0
# Local-first: Qwen 3.5 2B para máquinas simples; use qwen3.5:4b se houver memória.
# O fallback envia a pergunta e os trechos RAG ao Claude somente quando o local
# não responde de forma suficiente. Desative-o para manter tudo offline.
SOFIA_AI_PROVIDER=auto
SOFIA_LOCAL_AI_TIMEOUT_SECONDS=15
SOFIA_LOCAL_AI_URL=http://127.0.0.1:11434
SOFIA_LOCAL_AI_MODEL=qwen3.5:2b
SOFIA_LOCAL_AI_CONTEXT=8192
SOFIA_LOCAL_VISION_MODEL=qwen2.5vl:3b
SOFIA_CLAUDE_FALLBACK_ENABLED=1
SOFIA_CLAUDE_ALLOW_GENERAL_KNOWLEDGE=1
# O Gemini é online e opcional: enriquece fontes durante a indexação. Depois,
# resumo/termos persistidos podem ser usados pela RAG local sem nova chamada.
GEMINI_API_KEY=defina_apenas_no_arquivo_local
SOFIA_GEMINI_SEMANTICS_ENABLED=0
SOFIA_GEMINI_MODEL=gemini-2.5-flash-lite
SOFIA_GEMINI_MAX_INPUT_CHARS=24000
SOFIA_CONTINUOUS_LEARNING_ENABLED=1
SOFIA_RESEARCH_EXTERNAL=0
SOFIA_API_ALLOW_PRIVATE=0
SOFIA_TOTP_KEY=gere_uma_chave_Fernet_32_bytes_em_base64
